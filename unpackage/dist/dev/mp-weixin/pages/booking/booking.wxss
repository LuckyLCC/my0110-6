
.container.data-v-d331dabb {
	width: 100%;
	min-height: 100vh;
	background-color: #f9f9f9;
	padding-bottom: 184rpx;
	padding-top: 0; /* 不设置容器顶部内边距，改为在 header 上控制 */
}
.header.data-v-d331dabb {
	position: -webkit-sticky;
	position: sticky;
	top: 0;
	width: 100%;
	background-color: rgba(249, 249, 249, 0.9);
	border-bottom: 2rpx solid #f3f4f6;
	display: flex;
	align-items: flex-start;
	padding-top: env(safe-area-inset-top, 0rpx); /* 与小程序关闭按钮顶部对齐，与会员商城保持一致 */
	padding-right: 40rpx;
	padding-bottom: 32rpx;
	padding-left: 40rpx;
	z-index: 10;
}
.header-title.data-v-d331dabb {
	color: #333333;
	font-size: 40rpx;
	font-weight: 500;
	line-height: 56rpx;
	letter-spacing: 3.1rpx;
}
.date-section.data-v-d331dabb {
	background-color: #ffffff;
	padding: 40rpx;
	box-shadow: 0 2rpx 6rpx 0 rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1);
}
.section-label.data-v-d331dabb {
	color: #999999;
	font-size: 28rpx;
	font-weight: 300;
	line-height: 40rpx;
	letter-spacing: 0.4rpx;
	display: block;
	margin-bottom: 32rpx;
}
.date-scroll.data-v-d331dabb {
	width: 100%;
	white-space: nowrap;
}
.date-list.data-v-d331dabb {
	display: flex;
	gap: 24rpx;
}
.date-item.data-v-d331dabb {
	width: 128rpx;
	height: 128rpx;
	border-radius: 28rpx;
	border: 2rpx solid #f3f4f6;
	background-color: #ffffff;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 8rpx;
	flex-shrink: 0;
}
.date-item.active.data-v-d331dabb {
	background-color: #4a5d50;
	border-color: #4a5d50;
	box-shadow: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.1), 0 4rpx 8rpx -4rpx rgba(0, 0, 0, 0.1);
}
.date-number.data-v-d331dabb {
	color: #4a5565;
	font-size: 24rpx;
	font-weight: 300;
	line-height: 32rpx;
	opacity: 0.8;
}
.date-number-active.data-v-d331dabb {
	color: #ffffff;
}
.date-weekday.data-v-d331dabb {
	color: #4a5565;
	font-size: 28rpx;
	font-weight: 500;
	line-height: 40rpx;
	letter-spacing: -0.3rpx;
}
.date-weekday-active.data-v-d331dabb {
	color: #ffffff;
}
.time-section.data-v-d331dabb {
	padding: 32rpx;
}
.time-grid.data-v-d331dabb {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 24rpx 24rpx;
}
.time-item.data-v-d331dabb {
	height: 84rpx;
	border-radius: 20rpx;
	border: 2rpx solid #f3f4f6;
	background-color: #ffffff;
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
}
.time-item.active.data-v-d331dabb {
	background-color: rgba(74, 93, 80, 0.05);
	border-color: #4a5d50;
}
.time-item.disabled.data-v-d331dabb {
	background-color: #f9fafb;
	border-color: #e5e7eb;
	opacity: 0.5;
}
.time-text.data-v-d331dabb {
	color: #4a5565;
	font-size: 24rpx;
	font-weight: 300;
	line-height: 32rpx;
	letter-spacing: 1.2rpx;
}
.time-text-active.data-v-d331dabb {
	color: #4a5d50;
}
.time-text-disabled.data-v-d331dabb {
	color: #999999;
}
.time-check.data-v-d331dabb {
	position: absolute;
	top: 0;
	right: 0;
	width: 24rpx;
	height: 24rpx;
	background-color: #4a5d50;
	border-radius: 0 20rpx 0 20rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.check-icon.data-v-d331dabb {
	color: #ffffff;
	font-size: 16rpx;
}
.cabin-section.data-v-d331dabb {
	padding: 0 32rpx;
}
.cabin-grid.data-v-d331dabb {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 32rpx;
}
.cabin-item.data-v-d331dabb {
	background-color: #ffffff;
	border: 2rpx solid #f3f4f6;
	border-radius: 32rpx;
