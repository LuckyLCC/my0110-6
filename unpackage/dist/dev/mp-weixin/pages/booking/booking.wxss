	margin-bottom: 32rpx;
	text-align: center;
}
.seat-row.data-v-d331dabb {
	display: flex;
	gap: 32rpx;
	justify-content: space-between;
}
.seat-item.data-v-d331dabb {
	flex: 1;
	height: 132rpx;
	border-radius: 20rpx;
	border: 2rpx solid rgba(0, 0, 0, 0);
	background-color: #ffffff;
	display: flex;
	align-items: center;
	justify-content: center;
}
.seat-item.active.data-v-d331dabb {
