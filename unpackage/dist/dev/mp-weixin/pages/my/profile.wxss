
.page.data-v-daa3bc30 {
	width: 100%;
	min-height: 100vh;
	background-color: #f5f7f9;
}

/* 顶部导航栏 */
.header.data-v-daa3bc30 {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 112rpx;
	background-color: #ffffff;
	border-bottom: 2rpx solid #f3f4f6;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding-top: env(safe-area-inset-top, 0rpx);
	padding-left: 16rpx;
	padding-right: 16rpx;
	z-index: 10;
	box-shadow: 0 2rpx 6rpx 0 rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1);
}
.back-btn.data-v-daa3bc30 {
	width: 72rpx;
	height: 72rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 16rpx;
}
.back-icon.data-v-daa3bc30 {
	width: 36rpx;
	height: 36rpx;
}
.header-title.data-v-daa3bc30 {
	font-size: 32rpx;
	font-weight: 600;
	color: #1d293d;
	letter-spacing: -0.625rpx;
	line-height: 48rpx;
}
.header-right.data-v-daa3bc30 {
	width: 72rpx;
	height: 72rpx;
}
.scroll.data-v-daa3bc30 {
	height: 100vh;
	background-color: #f5f7f9;
	padding-top: 112rpx;
}
.content.data-v-daa3bc30 {
	padding: 32rpx;
	padding-bottom: 0;
}

/* 头像区域 */
.avatar-section.data-v-daa3bc30 {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: 32rpx;
	padding-top: 32rpx;
}
.avatar-container.data-v-daa3bc30 {
	position: relative;
	width: 192rpx;
	height: 192rpx;
	margin-bottom: 16rpx;
}
.avatar-wrapper.data-v-daa3bc30 {
	width: 192rpx;
	height: 192rpx;
	border-radius: 50%;
	background-color: #ffffff;
	border: 2rpx solid #f3f4f6;
	padding: 10rpx;
	box-shadow: 0 2rpx 6rpx 0 rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1);
}
.avatar.data-v-daa3bc30 {
	width: 100%;
	height: 100%;
	border-radius: 50%;
	background-color: #f0f0f0;
}
.avatar-hint.data-v-daa3bc30 {
	font-size: 28rpx;
	color: #99a1af;
	line-height: 40rpx;
	letter-spacing: -0.3rpx;
	text-align: center;
}

/* 个人信息卡片 */
.info-card.data-v-daa3bc30 {
	background-color: #ffffff;
	border-radius: 32rpx;
	border: 2rpx solid rgba(243, 244, 246, 0.5);
	box-shadow: 0 2rpx 6rpx 0 rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1);
	margin-bottom: 32rpx;
	overflow: hidden;
}
.info-row.data-v-daa3bc30 {
	display: flex;
	align-items: center;
	min-height: 111rpx;
	padding: 0 32rpx;
	position: relative;
}
.info-label.data-v-daa3bc30 {
	font-size: 30rpx;
	color: #45556c;
	width: 160rpx;
	flex-shrink: 0;
	letter-spacing: -0.47rpx;
	line-height: 45rpx;
	font-weight: 400;
}
.info-value.data-v-daa3bc30 {
	flex: 1;
	font-size: 30rpx;
	font-weight: 500;
	color: #1d293d;
	text-align: right;
	letter-spacing: -0.47rpx;
	line-height: 45rpx;
}
.divider.data-v-daa3bc30 {
	height: 2rpx;
	background-color: #f9fafb;
	margin-left: 32rpx;
}

/* 性别选择 */
.gender-group.data-v-daa3bc30 {
	display: flex;
	align-items: center;
	gap: 48rpx;
	flex: 1;
	justify-content: flex-end;
}
.gender-item.data-v-daa3bc30 {
	display: flex;
	align-items: center;
	gap: 16rpx;
}
.radio.data-v-daa3bc30 {
	width: 32rpx;
	height: 32rpx;
	border-radius: 50%;
	border: 2rpx solid #d1d5dc;
	background-color: transparent;
	box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.05);
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
}
.radio-selected.data-v-daa3bc30 {
	background-color: #1b3b2f;
	border-color: #1b3b2f;
}
.radio-icon.data-v-daa3bc30 {
	width: 16rpx;
	height: 16rpx;
}
.gender-text.data-v-daa3bc30 {
	font-size: 30rpx;
	color: #314158;
	letter-spacing: -0.47rpx;
}

/* 保存修改按钮 */
.save-btn.data-v-daa3bc30 {
	width: 100%;
	height: 96rpx;
	background-color: #4a5d50;
	border-radius: 9999rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 32rpx;
	box-shadow: 0 20rpx 30rpx -6rpx rgba(27, 59, 47, 0.1), 0 8rpx 12rpx -8rpx rgba(27, 59, 47, 0.1);
}
.save-btn-text.data-v-daa3bc30 {
	font-size: 32rpx;
	font-weight: 500;
	color: #ffffff;
	letter-spacing: -0.625rpx;
}

/* 退出登录 */
.logout-btn.data-v-daa3bc30 {
	width: 100%;
	height: 96rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 32rpx;
}
.logout-text.data-v-daa3bc30 {
	font-size: 32rpx;
	font-weight: 500;
	color: #fb2c36;
	letter-spacing: -0.625rpx;
}
.bottom-safe.data-v-daa3bc30 {
	height: env(safe-area-inset-bottom, 0rpx);
}
